# Project ENVs
VENV_PATH=/opt/venv

# Django ENVs
SECRET_KEY="your-secure-secret-key"
DEBUG=1 # change to 0 in production
LOG_LEVEL=INFO # e.g. DEBUG, INFO, WARNING, ERROR, CRITICAL
REDIS_CACHE_URL=redis://<username>:<password>@<host>:6379/<database_number> # e.g. redis://redis:6379/0
DB_NAME=<database-name>
DB_USER=<database-admin-user>
DB_PASSWORD=<database-admin-password>
DB_HOST=<database-service-host> # docker-compose database service name e.g. db or localhost (with exposed port)
DB_PORT=<database-port>

# Celery ENVs
CELERY_BROKER_URL=redis://<username>:<password>@<host>:6379/<database_number> # e.g. redis://redis:6379/0

# Postgres ENVs
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-admin-user>
POSTGRES_PASSWORD=<database-admin-password>
POSTGRES_PORT=<database-port>
