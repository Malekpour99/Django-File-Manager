# Django: core.django.local for development, core.django.stage for staging,
# or core.django.production for production.
DJANGO_SETTINGS_MODULE=core.django.local
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_LOG_LEVEL=INFO
DJANGO_CORS_ALLOW_ALL_ORIGINS=False
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Django database connection (Docker Compose service hostname).
DJANGO_DB_NAME=filemanager
DJANGO_DB_USER=filemanager
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=db
DJANGO_DB_PORT=5432

# PostgreSQL container; match these credentials to DJANGO_DB_* above.
POSTGRES_DB=filemanager
POSTGRES_USER=filemanager
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Optional integrations: enabled here for the Docker development stack.
# When disabled, use local memory caching, local files and synchronous tasks.
USE_REDIS_CACHE=True
REDIS_CACHE_URL=redis://redis:6379/2
USE_CELERY=True
CELERY_BROKER_URL=redis://redis:6379/1
USE_MINIO=True
MINIO_STORAGE_ENDPOINT=minio:9000
MINIO_EXTERNAL_STORAGE_ENDPOINT=http://127.0.0.1:9000
MINIO_STORAGE_ACCESS_KEY=
MINIO_STORAGE_SECRET_KEY=
MINIO_STORAGE_USE_HTTPS=False
MINIO_STORAGE_MEDIA_BUCKET_NAME=media
MINIO_STORAGE_STATIC_BUCKET_NAME=static
# Optional overrides for public bucket URLs:
# MINIO_STORAGE_STATIC_URL=http://127.0.0.1:9000/static
# MINIO_STORAGE_MEDIA_URL=http://127.0.0.1:9000/media

# Media tools (provided by the Docker image).
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
MEDIA_PROCESS_TIMEOUT=30

# Docker development mail service; default without this is console email.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp4dev
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost

# Deployment defaults (used by core.django.production and core.django.stage).
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
